{
  "name": "FinPay",
  "user": "ubuntu",
  "install": "./scripts/setup.sh",
  "start": "./scripts/start-services.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && . .venv/bin/activate && uvicorn app.main:asgi --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev"
    }
  ],
  "ports": [8000, 5173]
}
