# Optional: override the backend the Vite dev server proxies to.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Firebase Cloud Messaging (web push). Leave empty to disable push; devices are
# still registered without a token. Fill these with your Firebase web app values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
