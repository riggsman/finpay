# FinPay backend configuration
APP_NAME=FinPay
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg2://finpay:finpay@localhost:5432/finpay

# Redis (Socket.IO distribution / future workers). Optional.
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=1209600

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# In development, OTP codes are returned in API responses to ease testing.
EXPOSE_OTP_IN_RESPONSE=true

# Default transaction PIN assigned at activation (development convenience).
DEFAULT_TRANSACTION_PIN=1234
VALIDATION_TOKEN_TTL_SECONDS=300
PROVIDER_PROCESSING_DELAY_SECONDS=2.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
