# FinPay backend configuration
APP_NAME=FinPay
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=mysql+pymysql://root@localhost:3306/finpay

# Redis (Socket.IO distribution / future workers). Optional.
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=1209600

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# In development, OTP codes are returned in API responses to ease testing.
EXPOSE_OTP_IN_RESPONSE=true

# Default transaction PIN assigned at activation (development convenience).
DEFAULT_TRANSACTION_PIN=1234
VALIDATION_TOKEN_TTL_SECONDS=300
PROVIDER_PROCESSING_DELAY_SECONDS=2.0

# Reconciliation worker (settles provider-timeout transactions)
RECONCILE_WORKER_ENABLED=true
RECONCILE_INTERVAL_SECONDS=5.0
RECONCILE_MIN_AGE_SECONDS=3.0

# Rate limiting (Redis-backed; fails open if Redis is down)
RATE_LIMIT_ENABLED=true
RL_OTP_INITIATE_LIMIT=6
RL_OTP_INITIATE_WINDOW=600
RL_LOGIN_LIMIT=10
RL_LOGIN_WINDOW=300
RL_PASSWORD_RESET_LIMIT=5
RL_PASSWORD_RESET_WINDOW=600
RL_VERIFY_OTP_LIMIT=12
RL_VERIFY_OTP_WINDOW=600

# Email notifications
# EMAIL_BACKEND: console, smtp, or disabled.
# In development the backend auto-starts a local mail catcher (no Docker) on
# SMTP 127.0.0.1:1025 with inbox at http://127.0.0.1:1080 and routes email there.
EMAIL_BACKEND=console
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@finpay.app

# Embedded mail catcher (started with uvicorn in development)
DEV_MAIL_SERVER_ENABLED=true
DEV_MAIL_SMTP_HOST=127.0.0.1
DEV_MAIL_SMTP_PORT=1025
DEV_MAIL_WEB_HOST=127.0.0.1
DEV_MAIL_WEB_PORT=1080

# Back Office bootstrap admin (development)
ADMIN_EMAIL=admin@local.dev
ADMIN_PHONE=+237600000001
ADMIN_PASSWORD=admin1234

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Campay mobile money — put secrets here (or real env vars), never in code.
# Leave username/password blank to disable Campay HTTP entirely.
# Credentials alone unlock Back Office Campay sandbox tests.
# Wallet MoMo collect/withdraw also need PAYMENT_MODE=live.
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_WEBHOOK_KEY=
CAMPAY_TIMEOUT_SECONDS=30

# Payment mode: simulated (default, local mock wallet path) or live (real Campay MoMo).
# Go-live checklist: credentials set, PAYMENT_MODE=live, public webhook URL pointed at
# /api/v1/webhooks/campay, RECONCILE_WORKER_ENABLED=true (or Celery beat running).
PAYMENT_MODE=simulated
